{
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "family": "learn-jenkins-app-task-def",
    "containerDefinitions": [
        {
            "name": "learn-jenkins-app",
            "image": "nginx:1.27-alpine",
            "portMappings": [
                {
                    "name": "ngnix-80-tip",
                    "containerPort": 80,
                    "hostPort": 80,
                    "protocol": "tcp",
                    "appProtocol": "http"
                }
            ],
            "essential": true
        }
    ],
    "volumes": [],
    "networkMode": "awsvpc",
    "memory": "3 GB",
    "cpu": "1 vCPU",
    "executionRoleArn": ""
}